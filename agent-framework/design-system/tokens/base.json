    "color": {
      "primary": { "$value": "#1e3a5f", "$type": "color", "$extensions": { "source": ["www/assets/css/custom.css:8", "www/partials/header.php:66", "portal/includes/header.php:110"] } },
      "primary-dark": { "$value": "#152a45", "$type": "color", "$extensions": { "source": ["www/assets/css/custom.css:9", "www/partials/header.php:67"] } },
      "primary-light": { "$value": "#2d5a8a", "$type": "color", "$extensions": { "source": ["www/partials/header.php:68"], "note": "Defined in Tailwind config but unused anywhere in either site" } },
      "secondary": { "$value": "#3b82f6", "$type": "color", "$extensions": { "source": ["www/assets/css/custom.css:10", "portal/assets/css/portal.css:5"], "note": "Equals Tailwind blue-500. Contrast on white ~3.7:1 — fails WCAG AA for normal text; see brand-guidelines.md accessibility rules" } },
      "accent": { "$value": "#0ea5e9", "$type": "color", "$extensions": { "source": ["www/assets/css/custom.css:11", "portal/includes/header.php:112"], "note": "Equals Tailwind sky-500; used only as border accent (www/index.php:134)" } },
      "logo-ink": { "$value": "#231815", "$type": "color", "$extensions": { "source": ["www/assets/logos/skyphoenix-logo.svg:5-23", "design-system/brand/logo/skyphoenix-logo-color.svg"], "role": "logo-only", "note": "Logo wordmark near-black. LOGO PALETTE ONLY — body text uses the light.json text tokens, not this. Note the black logo variant is pure #000000, not this value" } },
      "logo-red": { "$value": "#b92d26", "$type": "color", "$extensions": { "source": ["www/assets/logos/skyphoenix-logo.svg:5-23", "design-system/brand/logo/skyphoenix-logo-color.svg"], "role": "brand-moment", "note": "Phoenix body. Brand-owner decision 2026-07-20: logo, marketing gradients and splash surfaces ONLY. MUST NOT become a functional UI color — it is adjacent to the error color #dc2626 and would make 'brand' and 'destructive' ambiguous. See brand-guidelines.md" } },
      "logo-orange": { "$value": "#ed6d1f", "$type": "color", "$extensions": { "source": ["www/assets/logos/skyphoenix-logo.svg:5-23", "design-system/brand/logo/skyphoenix-logo-color.svg"], "role": "cta", "note": "Role is deliberately named 'cta', NOT 'accent' — brand.color.accent is already #0ea5e9 (Tailwind sky-500, used as a border accent). Reusing 'accent' for orange would make the two indistinguishable in generated per-platform artifacts. Phoenix accents. Brand-owner decision 2026-07-20: promoted to the UI accent / call-to-action color alongside navy primary. CONSTRAINTS (WCAG ratios computed 2026-07-20): 3.08:1 on white — fails AA normal text, passes AA large. WHITE TEXT ON THIS FILL IS ALSO 3.08:1 AND FAILS — an orange CTA button must use #231815 (5.61:1) or #000000 (6.81:1) label text, never white. 3.73:1 on navy #1e3a5f. Never a meaning-bearing thin icon in this color. Full table in brand-guidelines.md" } }
    },
    "gradient": {
      "hero": { "$value": "linear-gradient(135deg, #1e3a5f 0%, #152a45 100%)", "$type": "gradient", "$extensions": { "source": ["www/assets/css/custom.css:67-72", "portal/login.php:36"] } }
    }
  },
