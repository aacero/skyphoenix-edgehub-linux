<RCC>
    <!-- Bundled a11y fonts (SIL OFL 1.1 - see assets/fonts/LICENSE-OFL-*.txt).
         Prefix is "/assets/fonts" ON PURPOSE: Theme.qml resolves the font URLs
         relative to its own location, and it is loaded from qrc:/qml/Theme.qml
         (hub), qrc:/manager/Theme.qml (Manager) AND from the plain filesystem
         (qmltestrunner). "qrc:/assets/fonts/<file>" is the one URL Theme.qml can
         reach from both qrc prefixes, and on disk the same files really are at
         <repo>/assets/fonts/ - so one resolution rule works everywhere. -->
    <qresource prefix="/assets/fonts">
        <file alias="AtkinsonHyperlegible-Regular.ttf">fonts/AtkinsonHyperlegible-Regular.ttf</file>
        <file alias="AtkinsonHyperlegible-Bold.ttf">fonts/AtkinsonHyperlegible-Bold.ttf</file>
        <file alias="Lexend-Regular.ttf">fonts/Lexend-Regular.ttf</file>
        <file alias="Lexend-Bold.ttf">fonts/Lexend-Bold.ttf</file>
        <!-- Tabular readouts. `fontMono` used to be the string "JetBrains Mono,
             Fira Code, monospace", which Qt does NOT split into a family list -
             it matched the whole thing as one family name and let fontconfig
             pick, so the SAME widget rendered in real monospace here and in a
             proportional sans on the CI runner (proven by the visual-baseline
             diff, 2026-08-02). A countdown in a proportional face jitters on
             every digit change, which is the exact thing the mono token exists
             to prevent. Bundling the first face the stack already asked for is
             the only way every machine agrees. -->
        <file alias="JetBrainsMono-Regular.ttf">fonts/JetBrainsMono-Regular.ttf</file>
        <file alias="JetBrainsMono-Bold.ttf">fonts/JetBrainsMono-Bold.ttf</file>
        <!-- The product's own UI face, for the same reason as the mono one
             above. `fontDisplay`'s "system" option was the string "Inter, Segoe
             UI, Roboto, sans-serif", which Qt matches as ONE family name - so
             Inter was never selected on any machine, and what users actually got
             was each machine's default sans. Bundling the face the product has
             always named first makes the "product look" a fact instead of a
             wish, and makes it identical everywhere. -->
        <file alias="Inter-Regular.ttf">fonts/Inter-Regular.ttf</file>
        <file alias="Inter-Bold.ttf">fonts/Inter-Bold.ttf</file>
        <!-- Brand wordmark face. Chakra Petch (OFL 1.1) is a close free stand-in
             for the SKYPhoenix IT logo lettering (squared, angular, cut terminals).
             Used only for the "EdgeHub" lockup; swap in the real brand font later
             by replacing these files. -->
        <file alias="ChakraPetch-SemiBold.ttf">fonts/ChakraPetch-SemiBold.ttf</file>
        <file alias="ChakraPetch-Bold.ttf">fonts/ChakraPetch-Bold.ttf</file>
    </qresource>
</RCC>
