# Build artifacts
build/
target/
cmake-build-*/
out/
dist/
*.o
*.obj
*.a
*.so
*.dylib
moc_*.cpp
qrc_*.cpp
# Qt uic output belongs in ignored build directories. Anchor this fallback to
# the repository root so a real source header such as app/src/ui_state_recovery.h
# cannot disappear from a commit.
/ui_*.h

# Rust
**/target/
**/*.rs.bk
*.pdb

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.ipr
*.iws

# OS files
.DS_Store
Thumbs.db

# Qt
*.pro.user
*.autosave
Makefile
*.qm

# Packaging artifacts
*.pkg.tar.zst
*.pkg.tar.xz
*.deb
*.rpm
*.flatpak
*.AppImage
*.snap
packages/**/*.tar.*
packages/**/src/
packages/**/pkg/

# Testing
coverage/
# Commit-keyed audit evidence is retained locally or uploaded as a release/CI
# artifact. Screenshots and raw logs can be hundreds of MiB and must not bloat
# normal source history.
artifacts/
# Visible GUI suite evidence (tests/gui/run_gui_tests.sh): ~1000 grabImage PNGs
# plus a stitched video, ~35MB per run, wiped and regenerated on every run.
# Reproducible output, not source.
gui-evidence/
*.profraw
*.profdata
lcov.info
html/

# Documentation build
docs/book/
docs/site/
docs/node_modules/

# Secrets and local config
.env
.env.local
*.secret
secrets/

# Core dumps (anchored to repo root so the core/ source dir is not ignored)
/core.*
core.[0-9]*

# Logs (keep pattern but be more specific)
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Flatpak build
.flatpak-builder/
build-dir/
repo/

# AppImage build tree (packaging/appimage/build-appimage.sh). The *.AppImage
# output above was already ignored, but the ~1GB AppDir + downloaded linuxdeploy
# tools it builds in were not - running the documented build script dirtied the
# tree with untracked build output.
build-appimage/

# Python bytecode cache
__pycache__/
*.pyc
build-qa/
build-cov-agent/
# Local install-validation tree produced by release packaging checks.
build-install/

# Claude Code local state. Narrowed from a blanket `.claude/` on 2026-07-31: the agent
# framework RENDERS .claude/agents/, .claude/rules/ and .claude/skills/ and records them
# in agent-framework/generated-manifest.json, so ignoring the whole directory left 28
# generated files untracked and check-drift.py failed in CI with "in manifest but missing
# on disk" - green locally, red on the runner. Only the genuinely local state is ignored:
# settings.local.json is personal, and worktrees/ holds agent git worktrees - 37 of them
# once reached 26GB here.
.claude/settings.local.json
.claude/worktrees/
captures/

# agent framework
agent-framework/runs/
.claude/settings.local.json
.kimi-code/local.toml
*.bak-pre-framework
